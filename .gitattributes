# Normalize text files to LF in the repository so the JSON-Lines adapters and
# workflow files behave identically on Windows, macOS, and Linux checkouts.
* text=auto

*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
