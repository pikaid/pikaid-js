{
  "name": "pikaid",
  "version": "1.0.0",
  "description": "Official JavaScript and TypeScript implementation of pikaid: 26-character sortable Base36 identifiers with 96-bit cryptographic randomness and 17-byte binary storage.",
  "keywords": [
    "pikaid",
    "identifier",
    "unique-id",
    "sortable-id",
    "base36",
    "uuid",
    "ulid"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "logo.png"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pikaid/pikaid-js.git"
  },
  "homepage": "https://github.com/pikaid/pikaid-js",
  "bugs": {
    "url": "https://github.com/pikaid/pikaid-js/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:types": "npm run build && tsc -p tsconfig.type-tests.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:coverage": "npm run build && node scripts/run-tests.mjs --experimental-test-coverage --test-coverage-include=\"dist/esm/**\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85",
    "test:browser": "npm run build && node scripts/browser-test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:archive": "node scripts/archive-smoke.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "typescript": "~5.9.3"
  }
}
